class Card:
    def __init__(self, suit, rank):
        self.suit = suit
        self.rank = rank

    def __str__(self):
        return f"{self.rank} of {self.suit}"

    def get_display(self):
        """Return a simple text representation for GUI"""
        suit_symbols = {'Hearts': '♥', 'Diamonds': '♦', 'Clubs': '♣', 'Spades': '♠'}
        return f"{self.rank}{suit_symbols[self.suit]}"

    def get_value(self):
        if self.rank in ['Jack', 'Queen', 'King']:
            return 10
        elif self.rank == 'Ace':
            return 11
        else:
            return int(self.rank)

class Deck:
    def __init__(self):
        self.cards = []
        suits = ['Hearts', 'Diamonds', 'Clubs', 'Spades']
        ranks = ['2', '3', '4', '5', '6', '7', '8', '9', '10', 'Jack', 'Queen', 'King', 'Ace']
        
        # Shuffle suits and ranks for maximum randomness
        random.shuffle(suits)
        random.shuffle(ranks)
        
        for suit in suits:
            for rank in ranks:
                self.cards.append(Card(suit, rank))

    def shuffle(self):
        # Maximum randomness with multiple techniques
        # Use system entropy for seed
        entropy = os.urandom(16)
        seed_value = int(hashlib.sha256(entropy).hexdigest(), 16) % (2**32)
        random.seed(seed_value)
        
        # Multiple shuffle passes with different seeds
        for i in range(random.randint(7, 12)):
            random.seed(random.randint(0, 1000000))
            random.shuffle(self.cards)
        
        # Final shuffle with time-based seed
        random.seed(int(time.time() * 1000000) % 1000000)
        random.shuffle(self.cards)

    def deal(self):
        if not self.cards:
            self.__init__()
            self.shuffle()
        return self.cards.pop()

    def deal_weighted(self, player_value):
        """Deal a card with weighted probability based on player's current value"""
        if not self.cards:
            return self.deal()

        # Calculate weights based on how helpful each card would be
        weights = []
        for card in self.cards:
            value = card.get_value()
            if player_value + value <= 21:
                # Prefer cards that get closer to 21
                distance_to_21 = 21 - (player_value + value)
                if distance_to_21 == 0:
                    weights.append(10)  # Perfect!
                elif distance_to_21 <= 5:
                    weights.append(8)  # Very good
                else:
                    weights.append(5)  # Good
            else:
                # Avoid bust, but still possible
                weights.append(1)

        # Normalize weights
        total_weight = sum(weights)
        if total_weight == 0:
            return self.deal()  # Fallback

        # Select card based on weights
        r = random.uniform(0, total_weight)
        cumulative = 0
        for i, weight in enumerate(weights):
            cumulative += weight
            if r <= cumulative:
                return self.cards.pop(i)

        return self.cards.pop()  # Fallback

class Hand:
    def __init__(self):
        self.cards = []
        self.value = 0
        self.aces = 0
        self.bust_shield_used = False

    def add_card(self, card):
        self.cards.append(card)
        self.value += self.get_card_value(card)
        if card.rank == 'Ace':
            self.aces += 1
        self.adjust_for_ace()

    def get_card_value(self, card):
        if card.rank in ['Jack', 'Queen', 'King']:
            return 10
        elif card.rank == 'Ace':
            return 11
        else:
            return int(card.rank)

    def adjust_for_ace(self):
        while self.value > 21 and self.aces:
            self.value -= 10
            self.aces -= 1

    def get_display(self):
        """Return a more visual card representation"""
        suit_symbols = {'Hearts': '♥', 'Diamonds': '♦', 'Clubs': '♣', 'Spades': '♠'}
        suit_colors = {'Hearts': 'red', 'Diamonds': 'red', 'Clubs': 'black', 'Spades': 'black'}
        
        # Create visual card representations
        cards_display = []
        for card in self.cards:
            symbol = suit_symbols[card.suit]
            color = suit_colors[card.suit]
            card_text = f"[{card.rank}{symbol}]"
            cards_display.append(card_text)
        
        return cards_display

    def recalculate_value(self):
        """Recalculate the hand value from scratch"""
        self.value = 0
        self.aces = 0
        for card in self.cards:
            self.value += self.get_card_value(card)
            if card.rank == 'Ace':
                self.aces += 1
        self.adjust_for_ace()

    def is_bust(self):
        return self.value > 21

class Powerup:
    def __init__(self, name, unlock_threshold, cost_multiplier, cooldown_rounds, description):
        self.name = name
        self.unlock_threshold = unlock_threshold
        self.cost_multiplier = cost_multiplier
        self.cooldown_rounds = cooldown_rounds
        self.description = description
        self.unlocked = False
        self.cooldown = 0

    def can_use(self):
        return self.unlocked and self.cooldown == 0

    def use(self):
        if not self.can_use():
            return False
        self.cooldown = self.cooldown_rounds
        return True

    def reduce_cooldown(self):
        if self.cooldown > 0:
            self.cooldown -= 1

    def get_cost(self, bet):
        return int(bet * self.cost_multiplier)

class Player:
    def __init__(self, chips=50):
        self.chips = chips
        self.hand = Hand()
        self.high_score = chips
        self.powerups = {
            'lucky_draw': Powerup('Lucky Draw', 225, 0.20, 2, 'Weighted card draw for better odds'),
            'peek': Powerup('Peek', 375, 0.60, 3, 'See dealer card range (Low/Mid/High)'),
            'swap': Powerup('Swap', 700, 0.65, 4, 'Randomly swap a card with dealer'),
            'bust_shield': Powerup('Bust Shield', 900, 0.80, 5, 'Forgive first bust')
        }
        self.active_powerup = None
        self.rounds_played = 0

    def reset_hand(self):
        self.hand = Hand()

    def place_bet(self, amount):
        if amount > self.chips:
            raise ValueError("Not enough chips")
        if amount <= 0:
            raise ValueError("Bet must be positive")
        self.chips -= amount
        return amount

    def win_bet(self, amount):
        self.chips += amount
        if self.chips > self.high_score:
            self.high_score = self.chips
        self.check_unlocks()

    def lose_bet(self, amount):
        pass  # Already deducted

    def check_unlocks(self):
        for powerup in self.powerups.values():
            if not powerup.unlocked and self.chips >= powerup.unlock_threshold:
                powerup.unlocked = True

    def use_powerup(self, powerup_name, bet):
        powerup = self.powerups.get(powerup_name)
        if not powerup or not powerup.can_use():
            return False

        cost = powerup.get_cost(bet)
        if self.chips < cost:
            raise ValueError(f"Not enough chips for {powerup.name} (costs ${cost})")

        self.chips -= cost
        if powerup.use():
            self.active_powerup = powerup_name
            return True
        return False

    def end_round(self):
        self.rounds_played += 1
        for powerup in self.powerups.values():
            powerup.reduce_cooldown()
        self.active_powerup = None

    def save_progress(self, filename):
        data = {
            'chips': self.chips,
            'high_score': self.high_score,
            'rounds_played': self.rounds_played,
            'powerups': {
                name: {
                    'unlocked': p.unlocked,
                    'cooldown': p.cooldown
                } for name, p in self.powerups.items()
            }
        }
        try:
            with open(filename, 'w') as f:
                json.dump(data, f)
        except Exception as e:
            raise Exception(f"Failed to save progress: {e}")

    def load_progress(self, filename):
        try:
            with open(filename, 'r') as f:
                data = json.load(f)
            self.chips = data.get('chips', 50)
            self.high_score = data.get('high_score', self.chips)
            self.rounds_played = data.get('rounds_played', 0)
            powerup_data = data.get('powerups', {})
            for name, p_data in powerup_data.items():
                if name in self.powerups:
                    self.powerups[name].unlocked = p_data.get('unlocked', False)
                    self.powerups[name].cooldown = p_data.get('cooldown', 0)
        except FileNotFoundError:
            messagebox.showinfo("No Save File", "No previous save found. Starting with default chips.")
        except Exception as e:
            raise Exception(f"Failed to load progress: {e}")

class Dealer:
    def __init__(self):
        self.hand = Hand()

    def reset_hand(self):
        self.hand = Hand()

    def peek_card(self):
        """Return the range of the hidden card"""
        if not self.hand.cards:
            return "No card"
        card = self.hand.cards[0]
        value = card.get_value()
        if value <= 6:
            return "LOW (2-6)"
        elif value <= 9:
            return "MID (7-9)"
        else:
            return "HIGH (10-Ace)"

class BlackjackGame:
    def __init__(self):
        self.deck = Deck()
        self.player = Player()
        self.dealer = Dealer()
        self.bet = 0
        self.game_over = False
        self.powerup_used_this_round = False
        self.powerup_used_name = None
        self.card_sound = None
        self.payout_sound = None
        self.sound_enabled = PYGAME_AVAILABLE
        
        if self.sound_enabled:
            try:
                pygame.mixer.init()
                self.load_card_sound()
                self.load_payout_sound()
            except Exception as e:
                print(f"Could not initialize sound: {e}")
                self.sound_enabled = False
    
    def get_resource_path(self, filename):
        """Resolve files from the script directory or PyInstaller bundle."""
        if hasattr(sys, '_MEIPASS'):
            return os.path.join(sys._MEIPASS, filename)
        script_dir = os.path.dirname(os.path.abspath(__file__))
        return os.path.join(script_dir, filename)

    def load_card_sound(self, sound_file="card_draw.wav"):
        """Load a card draw sound effect. Place card_draw.wav in the same directory as this script."""
        if not self.sound_enabled:
            return

        try:
            sound_path = self.get_resource_path(sound_file)
            if os.path.exists(sound_path):
                self.card_sound = pygame.mixer.Sound(sound_path)
                return

            # Fallback to current working directory if launched from exe
            alternate = os.path.join(os.getcwd(), sound_file)
            if os.path.exists(alternate):
                self.card_sound = pygame.mixer.Sound(alternate)
                return

            print(f"Sound file not found: {sound_path} or {alternate}")
            print("To enable card sounds, place card_draw.wav in the same directory as the executable or script.")
            self.sound_enabled = False
        except Exception as e:
            print(f"Could not load card sound: {e}")
            self.sound_enabled = False

    def generate_payout_sound(self, sound_file="payout.wav"):
        """Generate a simple payout sound effect if one is not available."""
        if not self.sound_enabled:
            return None

        sound_path = self.get_resource_path(sound_file)
        if os.path.exists(sound_path):
            return sound_path

        alternate = os.path.join(os.getcwd(), sound_file)
        if os.path.exists(alternate):
            return alternate

        try:
            sample_rate = 44100
            duration = 0.7
            num_samples = int(sample_rate * duration)
            amplitude = 16000
            data = bytearray()

            for i in range(num_samples):
                t = i / sample_rate
                freq = 880 + 440 * (i / num_samples)
                sample = int(amplitude * math.sin(2 * math.pi * freq * t) * (1 - i / num_samples))
                data += sample.to_bytes(2, byteorder='little', signed=True)

            with wave.open(sound_path, 'wb') as wf:
                wf.setnchannels(1)
                wf.setsampwidth(2)
                wf.setframerate(sample_rate)
                wf.writeframes(data)

            return sound_path
        except Exception as e:
            print(f"Could not generate payout sound: {e}")
            return None

        try:
            sample_rate = 44100
            duration = 0.7
            num_samples = int(sample_rate * duration)
            amplitude = 16000
            data = bytearray()

            for i in range(num_samples):
                t = i / sample_rate
                freq = 880 + 440 * (i / num_samples)
                sample = int(amplitude * math.sin(2 * math.pi * freq * t) * (1 - i / num_samples))
                data += sample.to_bytes(2, byteorder='little', signed=True)

            with wave.open(sound_path, 'wb') as wf:
                wf.setnchannels(1)
                wf.setsampwidth(2)
                wf.setframerate(sample_rate)
                wf.writeframes(data)

            return sound_path
        except Exception as e:
            print(f"Could not generate payout sound: {e}")
            return None

    def load_payout_sound(self, sound_file="payout.wav"):
        """Load or generate the payout win sound effect."""
        if not self.sound_enabled:
            return

        try:
            sound_path = self.generate_payout_sound(sound_file)
            if sound_path and os.path.exists(sound_path):
                self.payout_sound = pygame.mixer.Sound(sound_path)
            else:
                print(f"Payout sound file not found or could not be generated: {sound_file}")
        except Exception as e:
            print(f"Could not load payout sound: {e}")
            self.payout_sound = None

    def play_card_sound(self):
        """Play the card draw sound effect"""
        if self.sound_enabled and self.card_sound:
            try:
                self.card_sound.play()
            except Exception as e:
                print(f"Could not play sound: {e}")

    def play_payout_sound(self):
        """Play the win payout sound effect"""
        if self.sound_enabled and self.payout_sound:
            try:
                self.payout_sound.play()
            except Exception as e:
                print(f"Could not play payout sound: {e}")

    def start_new_game(self):
        self.deck = Deck()
        self.deck.shuffle()
        self.player.reset_hand()
        self.dealer.reset_hand()
        self.game_over = False
        self.powerup_used_this_round = False
        self.powerup_used_name = None

        # Deal initial cards
        self.player.hand.add_card(self.deck.deal())
        self.play_card_sound()
        self.dealer.hand.add_card(self.deck.deal())
        self.play_card_sound()
        self.player.hand.add_card(self.deck.deal())
        self.play_card_sound()
        self.dealer.hand.add_card(self.deck.deal())
        self.play_card_sound()

    def player_hit(self):
        if self.game_over:
            return

        if self.player.active_powerup == 'lucky_draw':
            card = self.deck.deal_weighted(self.player.hand.value)
            self.player.active_powerup = None  # One-time use
        else:
            card = self.deck.deal()

        self.player.hand.add_card(card)
        self.play_card_sound()

        # Check for bust shield
        if self.player.hand.is_bust() and not self.player.hand.bust_shield_used and self.player.powerups['bust_shield'].can_use():
            self.player.hand.bust_shield_used = True
            self.player.powerups['bust_shield'].use()
            # Shield prevents bust this time - don't end game
            return

        if self.player.hand.is_bust():
            self.game_over = True
        elif self.player.hand.value == 21:
            # Automatically stand when reaching 21
            self.player_stand()

    def player_stand(self):
        if self.game_over:
            return
        # Dealer plays
        while self.dealer.hand.value < 17:
            self.dealer.hand.add_card(self.deck.deal())
        self.game_over = True

    def use_powerup(self, powerup_name):
        if self.powerup_used_this_round:
            raise ValueError("Already used a powerup this round")
        if self.player.use_powerup(powerup_name, self.bet):
            self.powerup_used_this_round = True
            self.powerup_used_name = powerup_name
            return True
        return False

    def activate_peek(self):
        return self.dealer.peek_card()

    def activate_swap(self):
        # Randomly swap one card between player and dealer
        if not self.player.hand.cards or not self.dealer.hand.cards:
            return False

        # Choose random card from player
        player_card_idx = random.randint(0, len(self.player.hand.cards) - 1)
        player_card = self.player.hand.cards[player_card_idx]

        # Choose random card from dealer
        dealer_card_idx = random.randint(0, len(self.dealer.hand.cards) - 1)
        dealer_card = self.dealer.hand.cards[dealer_card_idx]

        # Swap
        self.player.hand.cards[player_card_idx] = dealer_card
        self.dealer.hand.cards[dealer_card_idx] = player_card

        # Recalculate values
        self.player.hand.recalculate_value()
        self.dealer.hand.recalculate_value()

        return True

    def get_winner(self):
        if self.player.hand.is_bust():
            return "dealer"
        elif self.dealer.hand.is_bust():
            return "player"
        elif self.player.hand.value > self.dealer.hand.value:
            return "player"
        elif self.dealer.hand.value > self.player.hand.value:
            return "dealer"
        else:
            return "push"

    def resolve_bet(self):
        winner = self.get_winner()
        if winner == "player":
            is_blackjack = len(self.player.hand.cards) == 2 and self.player.hand.value == 21
            if is_blackjack:
                if self.powerup_used_name == 'lucky_draw':
                    self.player.win_bet(int(self.bet * 1.25))
                else:
                    self.player.win_bet(int(self.bet * 2.5))
            else:
                self.player.win_bet(self.bet * 2)
        elif winner == "push":
            self.player.win_bet(self.bet)

        self.player.end_round()

