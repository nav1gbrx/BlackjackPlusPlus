        self.stand_button.pack(side=tk.LEFT, padx=20)

        self.new_game_button = tk.Button(action_frame, text="NEW GAME", command=self.new_game, 
                                        width=12, height=2, font=("Georgia", 12, "bold"),
                                        bg='#4444FF', activebackground='#0000CC')
        self.new_game_button.pack(side=tk.LEFT, padx=20)

        # Utility buttons
        util_frame = tk.Frame(self.button_frame, bg='#0F4C13')
        util_frame.pack(side=tk.TOP, pady=5)
        
        self.save_button = tk.Button(util_frame, text="SAVE", command=self.save_game, 
                                    width=10, height=1, font=("Georgia", 10),
                                    bg='#FFFF44', activebackground='#CCCC00')
        self.save_button.pack(side=tk.LEFT, padx=10)

        self.load_button = tk.Button(util_frame, text="LOAD", command=self.load_game, 
                                    width=10, height=1, font=("Georgia", 10),
                                    bg='#FFFF44', activebackground='#CCCC00')
        self.load_button.pack(side=tk.LEFT, padx=10)

        self.reset_button = tk.Button(util_frame, text="RESET CHIPS", command=self.reset_chips, 
                                     width=12, height=1, font=("Georgia", 10),
                                     bg='#FF8844', activebackground='#CC6600')
        self.reset_button.pack(side=tk.LEFT, padx=10)

        # Status
        self.status_label = tk.Label(self, text="", font=("Georgia", 14, "bold"), 
                                    bg='#0F4C13', fg='yellow')
        self.status_label.pack(pady=10)

    def update_display(self):
        self.chips_label.config(text=f"Chips: ${self.game.player.chips}")
        self.high_score_label.config(text=f"High Score: ${self.game.player.high_score}")

        # Dealer cards - hide first card if game not over
        if not self.game.game_over:
            dealer_display = ["??"] + self.game.dealer.hand.get_display()[1:]
            dealer_value = "?"
        else:
            dealer_display = self.game.dealer.hand.get_display()
            dealer_value = self.game.dealer.hand.value

        self.dealer_cards_label.config(text=" ".join(dealer_display))
        self.dealer_value_label.config(text=f"Value: {dealer_value}")

        # Player cards
        self.player_cards_label.config(text=" ".join(self.game.player.hand.get_display()))
        self.player_value_label.config(text=f"Value: {self.game.player.hand.value}")

        # Update powerup buttons and labels
        for name, powerup in self.game.player.powerups.items():
            btn = self.powerup_buttons[name]
            label = self.powerup_labels[name]

            if not powerup.unlocked:
                btn.config(state=tk.DISABLED, text=f"{powerup.name}\n(${powerup.unlock_threshold})")
                label.config(text="Locked")
            elif powerup.cooldown > 0:
                btn.config(state=tk.DISABLED)
                label.config(text=f"Cooldown: {powerup.cooldown}")
            elif self.game.powerup_used_this_round:
                btn.config(state=tk.DISABLED)
                label.config(text="Used")
            else:
                btn.config(state=tk.NORMAL)
                cost = powerup.get_cost(self.game.bet) if self.game.bet > 0 else 0
                label.config(text=f"${cost}")

        # Update buttons
        if self.game.game_over:
            self.hit_button.config(state=tk.DISABLED)
            self.stand_button.config(state=tk.DISABLED)
            self.new_game_button.config(state=tk.NORMAL)
        else:
            # Disable hit button if player has 21 or higher
            if self.game.player.hand.value >= 21:
                self.hit_button.config(state=tk.DISABLED)
            else:
                self.hit_button.config(state=tk.NORMAL)
            self.stand_button.config(state=tk.NORMAL)
            self.new_game_button.config(state=tk.DISABLED)
            self.status_label.config(text="")

    def hit(self):
        try:
            self.game.player_hit()
            self.update_display()
            if self.game.game_over:
                self.show_result()
        except Exception as e:
            messagebox.showerror("Error", str(e))

    def stand(self):
        try:
            self.game.player_stand()
            self.update_display()
            if self.game.game_over:
                self.show_result()
        except Exception as e:
            messagebox.showerror("Error", str(e))

    def use_powerup(self, powerup_name):
        try:
            if self.game.use_powerup(powerup_name):
                powerup = self.game.player.powerups[powerup_name]

                if powerup_name == 'peek':
                    peek_result = self.game.activate_peek()
                    messagebox.showinfo("Peek Result", f"Dealer's hidden card is: {peek_result}")
                elif powerup_name == 'swap':
                    if self.game.activate_swap():
                        messagebox.showinfo("Swap", "Cards swapped!")
                    else:
                        messagebox.showerror("Swap Failed", "Could not swap cards")

                self.update_display()
            else:
                messagebox.showerror("Powerup Failed", "Could not use powerup")
        except Exception as e:
            messagebox.showerror("Error", str(e))

    def new_game(self):
        try:
            if self.game.player.chips < 1:
                reset = messagebox.askyesno("Out of Chips", "You're out of chips! Start a new game with $50?", default=messagebox.YES)
                if reset:
                    self.game.player.chips = 50
                    self.game.player.high_score = max(self.game.player.high_score, 50)
                    # Reset powerups to initial state
                    for powerup in self.game.player.powerups.values():
                        powerup.unlocked = False
                        powerup.cooldown = 0
                    self.game.player.rounds_played = 0
                    self.game.powerup_used_this_round = False
                    self.game.powerup_used_name = None
                    self.update_display()
                    messagebox.showinfo("New Game", "Started fresh with $50!")
                return

            bet = simpledialog.askinteger("Bet", f"How many chips to bet? (You have ${self.game.player.chips})", minvalue=1, maxvalue=self.game.player.chips)
            if bet is None:
                return
            self.game.bet = self.game.player.place_bet(bet)
            self.game.start_new_game()
            self.update_display()
        except ValueError as e:
            messagebox.showerror("Invalid Bet", str(e))

    def show_result(self):
        winner = self.game.get_winner()
        self.game.resolve_bet()
        if winner == "player":
            self.game.play_payout_sound()
            self.status_label.config(text="You win!")
        elif winner == "dealer":
            self.status_label.config(text="Dealer wins!")
        else:
            self.status_label.config(text="Push!")
        self.chips_label.config(text=f"Chips: ${self.game.player.chips}")
        self.high_score_label.config(text=f"High Score: ${self.game.player.high_score}")

    def save_game(self):
        filename = filedialog.asksaveasfilename(defaultextension=".json", filetypes=[("JSON files", "*.json")])
        if filename:
            try:
                self.game.player.save_progress(filename)
                messagebox.showinfo("Save Successful", "Game progress saved!")
            except Exception as e:
                messagebox.showerror("Save Failed", str(e))

    def load_game(self):
        filename = filedialog.askopenfilename(filetypes=[("JSON files", "*.json")])
        if filename:
            try:
                self.game.player.load_progress(filename)
                self.update_display()
                messagebox.showinfo("Load Successful", "Game progress loaded!")
            except Exception as e:
                messagebox.showerror("Load Failed", str(e))

    def reset_chips(self):
        confirm = messagebox.askyesno("Reset Chips", "Reset your chips to $50 and start fresh? This will reset all progress.", default=messagebox.NO)
        if confirm:
            self.game.player.chips = 50
            self.game.player.high_score = max(self.game.player.high_score, 50)
            # Reset powerups to initial state
            for powerup in self.game.player.powerups.values():
                powerup.unlocked = False
                powerup.cooldown = 0
            self.game.player.rounds_played = 0
            self.update_display()
            messagebox.showinfo("Reset Complete", "Chips reset to $50. Good luck!")

if __name__ == "__main__":
    app = BlackjackGUI()
    app.mainloop()
