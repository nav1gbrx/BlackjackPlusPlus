    def create_vignette_background(self):
        """Create a vignette effect on the green backdrop"""
        # Get current window size
        self.update_idletasks()
        width = self.winfo_width()
        height = self.winfo_height()
        
        # Fallback to default if not yet rendered
        if width <= 1 or height <= 1:
            width, height = 900, 650
        
        # Create base green image
        img = Image.new('RGB', (width, height), color='#0F4C13')
        pixels = img.load()
        
        # Apply vignette effect - darken edges
        for y in range(height):
            for x in range(width):
                # Calculate distance from center
                center_x, center_y = width / 2, height / 2
                dx = (x - center_x) / center_x
                dy = (y - center_y) / center_y
                distance = (dx**2 + dy**2) ** 0.5
                
                # Apply vignette - darken based on distance from center
                vignette_strength = max(0, 1 - (distance * 0.8))
                
                # Get base color (casino green)
                r, g, b = 15, 76, 19
                # Darken based on vignette
                r = int(r * vignette_strength)
                g = int(g * vignette_strength)
                b = int(b * vignette_strength)
                
                pixels[x, y] = (r, g, b)
        
        # Convert to PhotoImage and update background
        self.bg_image = ImageTk.PhotoImage(img)
        self.bg_label.config(image=self.bg_image)
        self.bg_label.image = self.bg_image

